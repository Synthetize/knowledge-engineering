###############
# GIVEN A GUEST, FIND ALL MEALS THEY CAN EAT BASED ON THEIR DIET TYPE, MAX CALORIES, AND ALLERGIES
###############

PREFIX : <http://menu.ch#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?Meal (SUM(?cal) AS ?Calories) 
WHERE { 
	?guest :hasDietType ?diet .
	?guest :gMaxCalories ?maxCalories .

	?dish :hasIngredient ?ingredient .
    ?dish :name ?Meal .

	?ingredient :hasCalories ?cal .

	?diet :canEat ?dish .

	FILTER (?guest IN (:Guest2))

	FILTER NOT EXISTS {
		?dish :hasIngredient ?dishIngredient .
		?dishIngredient :containsAllergen ?containedAllergen .
		?guest :hasAllergy ?guestAllergy .
		FILTER (?containedAllergen = ?guestAllergy)
	}
   	
}
GROUP BY ?maxCalories ?Meal
HAVING (SUM(?cal) <= ?maxCalories)