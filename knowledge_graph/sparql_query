###############
# GIVEN A GUEST, FIND ALL MEALS THEY CAN EAT BASED ON THEIR DIET TYPE, MAX CALORIES, AND ALLERGIES
###############

PREFIX : <http://menu.ch#>

SELECT ?Meal (SUM(?cal) AS ?Calories)
WHERE {
  VALUES ?guest { :Guest2 } 

  ?guest :hasDietType ?diet ;
         :gMaxCalories ?maxCalories .

  OPTIONAL { ?guest :hasAllergy ?guestAllergy . }

  ?diet :canEat ?dish .
  ?dish :name ?Meal ;
        :hasIngredient ?ingredient .

  ?ingredient :hasCalories ?cal .

  FILTER NOT EXISTS {
    ?guest :hasAllergy ?guestAllergy .
    ?dish :hasIngredient ?dishIngredient .
    ?dishIngredient :containsAllergen ?guestAllergy .
  }
}
GROUP BY ?Meal ?maxCalories
HAVING (SUM(?cal) <= ?maxCalories)

# CAN BE CHANGED IF SOME PROPERTY IS INFERRED BY SWRL RULES

PREFIX : <http://menu.ch#>

SELECT ?Meal (SUM(?cal) AS ?Calories)
WHERE {
  VALUES ?guest { :Guest2 } 

  ?guest :hasDietType ?diet ;
         :gMaxCalories ?maxCalories .

  ?diet :canEat ?dish .
  ?dish :name ?Meal ;
        :hasIngredient ?ingredient .

  ?ingredient :hasCalories ?cal .

  FILTER NOT EXISTS {
    ?dish :notSuitableFor ?guest .
  }
}
GROUP BY ?Meal ?maxCalories
HAVING (SUM(?cal) <= ?maxCalories)

###############
# GIVEN A DIET TYPE, FIND ALL MEALS THAT CAN BE EATEN
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?Meal
WHERE {
    VALUES ?dietType { :Vegan }  

    ?dietType :canEat ?dish .
    ?dish :name ?Meal .

    FILTER NOT EXISTS {
        ?dish :hasIngredient ?ingredient .
        FILTER NOT EXISTS {
            ?ingredient :fitForDiet ?dietType .
        }
    }
}
ORDER BY ?Meal

###############
# GIVEN A DIET TYPE, FIND ALL THE INGREDIENTS THAT CAN BE EATEN
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?IngredientName
WHERE {
    VALUES ?dietType { :Omnivore }

    ?ingredient :fitForDiet ?dietType ;
                :name ?IngredientName .
}
ORDER BY ?IngredientName

###############
# GIVEN AN INGREDIENT, FIND ALL MEALS THAT CONTAIN IT
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?MealName
WHERE {
    VALUES ?ingredient { :WheatPasta }

    ?meal :hasIngredient ?ingredient ;
          :name ?MealName .
}
ORDER BY ?MealName

###############
# GIVEN AN ALLERGY, FIND ALL MEALS THAT CONTAIN IT
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?MealName
WHERE {
    VALUES ?allergen { :Fish }

    ?meal :hasIngredient ?ingredient ;
          :name ?MealName .

    ?ingredient :containsAllergen ?allergen .
}
ORDER BY ?MealName

###############
# CAN BE CHANGED IF SOME PROPERTY IS INFERRED BY SWRL RULES
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?MealName
WHERE {
    VALUES ?allergen { :Fish }

    ?meal :dishContainsAllergen ?allergen ;
          :name ?MealName .
}
ORDER BY ?MealName

###############
# GIVEN A MEAL, FIND ALL INGREDIENTS IN IT  
###############

PREFIX : <http://menu.ch#>

SELECT DISTINCT ?IngredientName
WHERE {
    VALUES ?meal { :Tiramisu }

    ?meal :hasIngredient ?ingredient .
    ?ingredient :name ?IngredientName .
}
ORDER BY ?IngredientName
