@prefix : <http://menu.ch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

###############
# GUEST CLASS
###############

:Guest a rdfs:Class .

###############
# DISH SUB-CLASSES
###############

:Dish a rdfs:Class .

:MainCourse a rdfs:Class ;
  rdfs:subClassOf :Dish .

:SecondCourse a rdfs:Class ;
  rdfs:subClassOf :Dish .

:Dessert a rdfs:Class ;
  rdfs:subClassOf :Dish .

###############
# DIET
###############

:Diet a rdfs:Class .

###############
# INGREDIENT SUB-CLASSES
###############

:Ingredient a rdfs:Class .

:DairyProduct a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:AnimalProduct a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:MeatProduct a rdfs:Class ;
  rdfs:subClassOf :AnimalProduct .

:Seafood a rdfs:Class ;
  rdfs:subClassOf :AnimalProduct .

:Vegetable a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:GrainProduct a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:Spice a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:Condiment a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:Alcohol a rdfs:Class ;
  rdfs:subClassOf :Ingredient .

:Water a rdfs:Class ;
 rdfs:subClassOf :Ingredient .

###############
# ALLERGIES
###############

:Allergen a rdfs:Class .

:Gluten a :Allergen ;
  :name "Gluten Intollerant"^^xsd:string ;
.
:Fish a :Allergen ;
  :name "Fish Intollerant"^^xsd:string ;
.
:EggsAllergen a :Allergen ;
  :name "Egg Intollerant"^^xsd:string ;
.
:Lactose a :Allergen ;
  :name "Lactose Intollerant"^^xsd:string ;
.
:Nuts a :Allergen ;
  :name "Nut Intollerant"^^xsd:string ;
.

###############
# OBJECT PROPERTIES
###############

:hasIngredient a owl:ObjectProperty ;
  rdfs:domain :Dish ;
  rdfs:range :Ingredient .

:canEat a owl:ObjectProperty ;
  rdfs:domain :Diet ;
  rdfs:range :Dish .

:containsAllergen a owl:ObjectProperty ;
  rdfs:domain :Ingredient ;
  rdfs:range :Allergen .

:dishContainsAllergen a owl:ObjectProperty ;
  rdfs:domain :Dish ;
  rdfs:range :Allergen .

:fitForDiet a owl:ObjectProperty ;
  rdfs:domain :Ingredient ;
  rdfs:range :Diet .

:hasAllergy a owl:ObjectProperty ;
  rdfs:domain :Guest ;
  rdfs:range :Allergen .

:hasDietType a owl:ObjectProperty ;
  rdfs:domain :Guest ;
  rdfs:range :Diet .

:notSuitableFor a owl:ObjectProperty ;
  rdfs:domain :Dish ;
  rdfs:range :Guest .

###############
# DATA PROPERTIES
###############

:name a owl:DatatypeProperty ;
  rdfs:domain [ owl:unionOf ( :Dish :Ingredient :Allergen :Guest ) ] ;
  rdfs:range xsd:string .

:hasCalories a owl:DatatypeProperty ;
  rdfs:domain :Ingredient ;
  rdfs:range xsd:int .

:gMaxCalories a owl:DatatypeProperty ;
  rdfs:domain :Guest ;
  rdfs:range xsd:int .

###############
# GUESTS
###############

:Guest1 a :Guest ;
  :name "Guest 1"^^xsd:string ;
  :hasAllergy :Gluten ;
  :hasDietType :Vegan ;
  :gMaxCalories "500"^^xsd:int ;
.

:Guest2 a :Guest ;
  :name "Guest 2"^^xsd:string ;
  :hasDietType :Omnivore ;
  :gMaxCalories "3000"^^xsd:int ;
.

:Guest3 a :Guest ;
  :name "Guest 3"^^xsd:string ;
  :gMaxCalories "3000"^^xsd:int ;
  :hasAllergy :Lactose ;
  :hasDietType :Vegetarian ;
.

:Guest4 a :Guest ;
  :name "Guest 4"^^xsd:string ;
  :hasDietType :Omnivore ;
  :hasAllergy :Lactose ;
  :hasAllergy :Gluten ;
  :gMaxCalories "3000"^^xsd:int ;
.

###############
# DIETS
###############

:Omnivore a :Diet ;
  :name "Omnivore"^^xsd:string ;
  :canEat :SorbettoAlLimone ;
  :canEat :Tiramisu ;
  :canEat :CremaCaffe ;
  :canEat :RisottoAllaMilanese ;
  :canEat :Carbonara ;
  :canEat :Lasagna ;
  :canEat :SpaghettiAlleVongole ;
  :canEat :PastaAlBurroParmigianoPepeNero ;
  :canEat :SpaghettiAlPomodoro ;
  :canEat :RisoConPomodoroCipollaPrezzemolo ;
  :canEat :BisteccaAllaFiorentina ;
  :canEat :ScaloppineAlLimone ;
  :canEat :InvoltiniDiManzoAlParmigiano ;
  :canEat :GuancialeCroccanteConUova ;
  :canEat :OmeletteParmigianoCipolle ;
  :canEat :MistoVerdure ;
  :canEat :SalmoneInCrosta ;
.

:Vegetarian a :Diet ;
  :name "Vegetarian"^^xsd:string ;
  :canEat :SorbettoAlLimone ;
  :canEat :Tiramisu ;
  :canEat :CremaCaffe ;
  :canEat :RisottoAllaMilanese ;
  :canEat :SpaghettiAlPomodoro ;
  :canEat :PastaAlBurroParmigianoPepeNero ;
  :canEat :OmeletteParmigianoCipolle ;
  :canEat :MistoVerdure ;
.

:Vegan a :Diet ;
  :name "Vegan"^^xsd:string ;
  :canEat :SorbettoAlLimone ;
  :canEat :SpaghettiAlPomodoro ;
  :canEat :RisoConPomodoroCipollaPrezzemolo ;
  :canEat :MistoVerdure ;
.

###############
# DISHES
###############

:SorbettoAlLimone a :Dessert ;
  :name "Sorbetto al limone"^^xsd:string ;
  :hasIngredient :Lemon ;
  :hasIngredient :Water ;
  :hasIngredient :Sugar ;
.

:CremaCaffe a :Dessert ;
  :name "Crema Caffe "^^xsd:string ;
  :hasIngredient :Coffee ;
  :hasIngredient :MascarponeCheese ;
  :hasIngredient :Water ;
  :hasIngredient :CocoaPowder ;
  :hasIngredient :Sugar ;
.

:RisottoAllaMilanese a :MainCourse ;
  :name "Risotto alla milanese"^^xsd:string ;
  :hasIngredient :Rice ;
