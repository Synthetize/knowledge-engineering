@prefix : <http://menu.ch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# RDF DEFS

:Dish a rdfs:Class .
:Diet a rdfs:Class .
:Ingredient a rdfs:Class .
:Allergen a rdfs:Class .

:hasIngredient a rdf:Property .
:name a rdf:Property .
:canEat a rdf:Property .
:hasCalories a rdf:Property .
:containsAllergen a rdf:Property ;
  rdfs:domain :Ingredient ;
  rdfs:range :Allergen .
  
:Gluten a :Allergen ;
  :name "Gluten Intollerant"^^xsd:string ;
.
:Fish a :Allergen ;
  :name "Fish Intollerant"^^xsd:string ;
.
:EggsAllergen a :Allergen ;
  :name "Egg Intollerant"^^xsd:string ;
.
:Lactose a :Allergen ;
  :name "Lactose Intollerant"^^xsd:string ;
.
:Nuts a :Allergen ;
  :name "Nut Intollerant"^^xsd:string ;
.

# DIETS

:Omnivore a :Diet ;
  :canEat :RisottoAllaMilanese ;
  :canEat :Carbonara ;
  :canEat :Lasagna ;
  :canEat :PolentaAllaSalsiccia ;
  :canEat :Tiramisu ;
  :canEat :TortelliniInBrodo ;
  :canEat :SpaghettiAlleVongole ;
.

:Vegetarian a :Diet ;
  :canEat :RisottoAllaMilanese ;
  :canEat :Tiramisu ;
.

# DISHES

:RisottoAllaMilanese a :Dish ;
  :name "Risotto alla milanese"^^xsd:string ;
  :hasIngredient :Rice ;
  :hasIngredient :Saffron ;
  :hasIngredient :Onion ;
  :hasIngredient :Butter ;
  :hasIngredient :ParmesanCheese ;
.

:Carbonara a :Dish ;
  :name "Carbonara"^^xsd:string ;
  :hasIngredient :WheatPasta ;
  :hasIngredient :Eggs ;
  :hasIngredient :PorkCheek ;
  :hasIngredient :PecorinoCheese ;
  :hasIngredient :BlackPepper ;
.

:Lasagna a :Dish ;
  :name "Lasagna"^^xsd:string ;
  :hasIngredient :WheatPastaSheets ;
  :hasIngredient :GroundBeef ;
  :hasIngredient :TomatoSauce ;
  :hasIngredient :BechamelSauce ;
.

:PolentaAllaSalsiccia a :Dish ;
  :name "Polenta alla salsiccia"^^xsd:string ;
  :hasIngredient :Cornmeal ;
  :hasIngredient :PorkSausage ;
  :hasIngredient :TomatoSauce ;
  :hasIngredient :Onion ;
  :hasIngredient :OliveOil ;
.

:Tiramisu a :Dish ;
  :name "Tiramisù"^^xsd:string ;
  :hasIngredient :Ladyfingers ;
  :hasIngredient :MascarponeCheese ;
  :hasIngredient :Eggs ;
  :hasIngredient :Sugar ;
  :hasIngredient :Coffee ;
  :hasIngredient :CocoaPowder ;
.

:TortelliniInBrodo a :Dish ;
  :name "Tortellini in brodo"^^xsd:string ;
  :hasIngredient :WheatTortellini ;
  :hasIngredient :MeatBroth ;
  :hasIngredient :Cheese ;
  :hasIngredient :Eggs ;
.

:SpaghettiAlleVongole a :Dish ;
  :name "Spaghetti alle vongole"^^xsd:string ;
  :hasIngredient :WheatSpaghetti ;
  :hasIngredient :Clams ;
  :hasIngredient :Garlic ;
  :hasIngredient :OliveOil ;
  :hasIngredient :Parsley ;
  :hasIngredient :WhiteWine ;
.

# INGREDIENTS

:Rice a :Ingredient ; 
  :name "Rice"^^xsd:string ;
  :hasCalories "130"^^xsd:int ;
.

:Saffron a :Ingredient ; 
  :name "Saffron"^^xsd:string ;
  :hasCalories "2"^^xsd:int ;
.

:Onion a :Ingredient ; 
  :name "Onion"^^xsd:string ;
  :hasCalories "40"^^xsd:int ;
.

:Butter a :Ingredient ; 
  :name "Butter"^^xsd:string ;
  :hasCalories "100"^^xsd:int ;
.

:ParmesanCheese a :Ingredient ; 
  :name "Parmesan Cheese"^^xsd:string ;
  :hasCalories "90"^^xsd:int ;
  :containsAllergen :Lactose ;
.

:WheatPasta a :Ingredient ; 
  :name "Wheat Pasta"^^xsd:string ;
  :hasCalories "220"^^xsd:int ;
  :containsAllergen :Gluten ;
.

:Eggs a :Ingredient ;
  :name "Eggs"^^xsd:string ;
  :hasCalories "70"^^xsd:int ;
  :containsAllergen :EggsAllergen ;
.

:PorkCheek a :Ingredient ;
  :name "Port Cheek"^^xsd:string ;
  :hasCalories "150"^^xsd:int ;
.

:PecorinoCheese a :Ingredient ;
  :name "Pecorino Cheese"^^xsd:string ;
  :hasCalories "80"^^xsd:int ;
  :containsAllergen :Lactose ;
.

:BlackPepper a :Ingredient ;
  :name "Black Pepper"^^xsd:string ;
  :hasCalories "5"^^xsd:int ;
.

:WheatPastaSheets a :Ingredient ;
  :name "Wheat Pasta Sheets"^^xsd:string ;
  :hasCalories "200"^^xsd:int ;
  :containsAllergen :Gluten ;
.

:GroundBeef a :Ingredient ;
  :name "Ground Beef"^^xsd:string ;
  :hasCalories "180"^^xsd:int ;
.

:TomatoSauce a :Ingredient ;
  :name "Tomato Sauce"^^xsd:string ;
  :hasCalories "60"^^xsd:int ;
.

:BechamelSauce a :Ingredient ;
  :name "Bechamel Sauce"^^xsd:string ;
  :hasCalories "90"^^xsd:int ;
  :containsAllergen :Lactose ;
.

:Cornmeal a :Ingredient ;
  :name "Cornmeal"^^xsd:string ;
  :hasCalories "170"^^xsd:int ;
.

:PorkSausage a :Ingredient ;
  :name "Pork Sausage"^^xsd:string ;
  :hasCalories "200"^^xsd:int ;
.

:OliveOil a :Ingredient ;
  :name "Olive Oil"^^xsd:string ;
  :hasCalories "120"^^xsd:int ;
.

:Ladyfingers a :Ingredient ;
  :name "Ladyfingers"^^xsd:string ;
  :hasCalories "120"^^xsd:int ;
  :containsAllergen :Gluten ; 
  :containsAllergen :EggsAllergen ;
.

:MascarponeCheese a :Ingredient ;
  :name "Mascarpone Cheese"^^xsd:string ;
  :hasCalories "100"^^xsd:int ;
  :containsAllergen :Lactose ;
.

:Sugar a :Ingredient ;
  :name "Sugar"^^xsd:string ;
  :hasCalories "60"^^xsd:int ;
.

:Coffee a :Ingredient ;
  :name "Coffee"^^xsd:string ;
  :hasCalories "2"^^xsd:int ;
.

:CocoaPowder a :Ingredient ;
  :name "Cocoa Powder"^^xsd:string ;
  :hasCalories "20"^^xsd:int ;
.

:WheatTortellini a :Ingredient ;
  :name "Wheat Tortellini"^^xsd:string ;
  :hasCalories "200"^^xsd:int ;
  :containsAllergen :Gluten ;
.

:MeatBroth a :Ingredient ;
  :name "Meat Broth"^^xsd:string ;
  :hasCalories "80"^^xsd:int ;
.

:WheatSpaghetti a :Ingredient ;
  :name "Wheat Spaghetti"^^xsd:string ;
  :hasCalories "220"^^xsd:int ;
  :containsAllergen :Gluten ;
.

:WhiteWine a :Ingredient ;
  :name "White Wine"^^xsd:string ;
  :hasCalories "10"^^xsd:int ;
.

:Clams a :Ingredient ;
  :name "Clams"^^xsd:string ;
  :hasCalories "70"^^xsd:int ;
  :containsAllergen :Fish ;
.

:Garlic a :Ingredient ;
  :name "Garlic"^^xsd:string ;
  :hasCalories "5"^^xsd:int ;
.

:Parsley a :Ingredient ;
  :name "Parsley"^^xsd:string ;
  :hasCalories "3"^^xsd:int ;
.

:Cheese a :Ingredient ;
  :name "Cheese"^^xsd:string ;
  :hasCalories "50"^^xsd:int ;
