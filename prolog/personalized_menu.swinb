is_animal(Ingredient) :- ingredient(Ingredient, animal, _, _).
is_animal_product(Ingredient) :- ingredient(Ingredient, animal_product, _, _).
is_plant(Ingredient) :- ingredient(Ingredient, plant, _, _).
is_mineral(Ingredient) :- ingredient(Ingredient, mineral, _, _).


%rules to check if a dish is vegan
is_vegan_ingredient(Ing) :- is_plant(Ing).
is_vegan_ingredient(Ing) :- is_mineral(Ing).

all_ingredients_are_vegan([]).
all_ingredients_are_vegan([Head|Tail]) :-
    is_vegan_ingredient(Head),
    all_ingredients_are_vegan(Tail).

is_vegan(Dish) :-
    dish(Dish, Ingredients),
    all_ingredients_are_vegan(Ingredients),
    !.

%rules to check if a dish is vegetarian
is_vegetarian_ingredient(Ing) :- is_plant(Ing).
is_vegetarian_ingredient(Ing) :- is_mineral(Ing).
is_vegetarian_ingredient(Ing) :- is_animal_product(Ing).

all_ingredients_are_vegetarian([]).
all_ingredients_are_vegetarian([Head|Tail]) :-
    is_vegetarian_ingredient(Head),
    all_ingredients_are_vegetarian(Tail).

is_vegetarian(Dish) :-
    dish(Dish, Ingredients),
    all_ingredients_are_vegetarian(Ingredients),
    !.

%rules to check if a dish is omnivore
is_omnivore(Dish) :-
    dish(Dish, _).

%check dish allergens
ingredient_contains_allergens(Ingredient, AllergensList) :-
    ingredient(Ingredient, _, _, IngredientAllergens),
    member(Allergen, AllergensList),     
    member(Allergen, IngredientAllergens).

dish_contains_allergens(Dish,AllergensList) :-
    dish(Dish,IngredientsList),
    member(Ingridient,IngredientsList),
    ingredient_contains_allergens(Ingridient,AllergensList),
    !.

%check dish calories
sum_calories([], 0).
sum_calories([Ingredient | Rest], TotalCalories) :-
    ingredient(Ingredient, _, Calories, _),
    sum_calories(Rest, RestCalories),
    TotalCalories is Calories + RestCalories.

is_dish_below_calories(Dish, MaxCalories) :-
    dish(Dish, Ingredients),
    sum_calories(Ingredients, TotalCalories),
    TotalCalories =&lt; MaxCalories.

%suggested dishes by client
suggested_dishes(ClientName, Dish) :-
    client(ClientName, DietType, MaxCalories, Allergens),
    dish(Dish, _),
 	(
        DietType = vegan -&gt; is_vegan(Dish);
        DietType = vegetarian -&gt; is_vegetarian(Dish);
        DietType = omnivore
    ),
    not(dish_contains_allergens(Dish,Allergens)),
    is_dish_below_calories(Dish, MaxCalories).
    
    




